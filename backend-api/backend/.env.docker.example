# Copy to .env for Docker. Replace every example secret before exposing this service.
APP_NAME=VEN
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
VEN_RUN_MIGRATIONS=true
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Generate with: openssl rand -base64 32
VEN_CUSTOM_KEY=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ven
VEN_DB_CLIENT_HOST=%
DB_LOG_CONNECTION=mysql
DB_APP_USERNAME=ven
DB_APP_PASSWORD=CHANGE_ME_APP
DB_USER_USERNAME=ven_user
DB_USER_PASSWORD=CHANGE_ME_USER
DB_ADMIN_USERNAME=ven_admin
DB_ADMIN_PASSWORD=CHANGE_ME_ADMIN
DB_DBA_USERNAME=ven_dba
DB_DBA_PASSWORD=CHANGE_ME_DBA
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SANCTUM_EXPIRATION=43200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_IDS=
LIVEKIT_URL=wss://livekit.example.invalid
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_URL=
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="VEN"

VEN_HTTP_PORT=8080
