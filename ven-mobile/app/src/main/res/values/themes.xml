<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mode terang: windowBackground mengikuti LightVexColors agar tidak ada
         kilatan gelap saat aplikasi diluncurkan. -->
    <style name="Theme.VEN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <style name="Theme.VEN.UnityLoading" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#110E1C</item>
        <item name="android:statusBarColor">#110E1C</item>
        <item name="android:navigationBarColor">#110E1C</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
