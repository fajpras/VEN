<?xml version="1.0" encoding="utf-8"?><!--
    Aturan ekstraksi data (API 31+): sesi otentikasi dan riwayat chat
    dikecualikan dari cloud backup maupun transfer perangkat.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ven_auth_pref.xml" />
        <exclude domain="sharedpref" path="ven_ai_chat_pref.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ven_auth_pref.xml" />
        <exclude domain="sharedpref" path="ven_ai_chat_pref.xml" />
    </device-transfer>
</data-extraction-rules>
